{
  "name": "@sethski/vibex",
  "version": "1.10.1",
  "description": "Local-first prompt optimizer and context bridge for AI coding tools.",
  "type": "module",
  "license": "MIT",
  "author": "sethski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sethski/vibeX.git"
  },
  "homepage": "https://github.com/sethski/vibeX#readme",
  "bugs": {
    "url": "https://github.com/sethski/vibeX/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "vibex": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry": "npm publish --dry-run",
    "bench:context": "node scripts/benchmark-context.mjs",
    "bench:check": "node scripts/check-benchmark-baseline.mjs",
    "quality:gate": "node scripts/check-optimization-snapshots.mjs",
    "spec2:check": "node scripts/check-spec2-acceptance.mjs",
    "release:hardening": "npm run test && npm run typecheck && npm run bench:check && npm run quality:gate && npm run spec2:check && npm run pack:dry",
    "publish:check": "npm run release:hardening",
    "publish:public": "npm publish --access public",
    "dev:server": "tsx src/bridge/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src",
    "config/*.json",
    "core/*.py",
    "plugins/*.py",
    "pyproject.toml",
    "docs/CONTRACTS.md",
    "docs/MIGRATIONS.md",
    "docs/CHANGELOG.md",
    "benchmarks/context-baseline.json",
    "benchmarks/optimization-snapshots.json",
    "assets/vibex-logo.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai",
    "prompt",
    "optimizer",
    "cli",
    "typescript",
    "local-first"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
